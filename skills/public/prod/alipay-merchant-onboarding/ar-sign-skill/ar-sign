#!/usr/bin/env bash
# 签约 Skill 统一入口命令
# 用法: ar-sign <子命令> [参数]
# 帮助: ar-sign -h / ar-sign <子命令> -h

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PYTHON="${PYTHON:-python3}"

show_help() {
    cat <<'EOF'
ar-sign — 签约 Skill 命令行工具

用法:
  ar-sign <子命令> [参数]

子命令:
  config          查看或修改数据目录配置
  clean           清理签约数据（持久数据 + 临时文件）
  status          查看当前签约数据状态
  apply           外部直调 apply（传入完整 MCP 参数直接提交）

通用参数:
  -h, --help      显示帮助信息

示例:
  ar-sign apply --data '{"request": {...}, "ctx": {}}'
  ar-sign config --data-dir /custom/path/
  ar-sign config --show
  ar-sign clean
  ar-sign status
EOF
}

# --- config 子命令 ---
cmd_config() {
    if [[ $# -eq 0 || "$1" == "-h" || "$1" == "--help" ]]; then
        cat <<'EOF'
ar-sign config — 查看或修改配置

配置写入 ~/.alipay/arSignConfig.json，所有脚本自动读取。
路径优先级: 脚本 CLI 参数 > arSignConfig.json > 默认值

用法:
  ar-sign config --data-dir <路径>       设置自定义数据目录
  ar-sign config --prefill-file <路径>   设置预填数据文件路径
  ar-sign config --show                  查看当前配置
  ar-sign config --reset                 重置为默认配置
  ar-sign config -h                      显示此帮助

示例:
  ar-sign config --data-dir /data/ar-sign/
  ar-sign config --prefill-file ~/data/prefill.json
  ar-sign config --show
  ar-sign config --reset
EOF
        return 0
    fi

    "$PYTHON" "$SCRIPT_DIR/scripts/setup_config.py" "$@"
}

# --- clean 子命令 ---
cmd_clean() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        cat <<'EOF'
ar-sign clean — 清理签约数据

删除数据目录下的所有签约数据（持久数据 + 临时文件），同时清除配置文件。
实际清理路径根据 ~/.alipay/arSignConfig.json 配置确定，默认为 ~/.alipay/ar/。

用法:
  ar-sign clean          执行清理（数据 + 配置）
  ar-sign clean --data   仅清理数据目录，保留配置
  ar-sign clean --dry    仅展示将清理的路径，不执行
  ar-sign clean -h       显示此帮助
EOF
        return 0
    fi

    local data_dir config_path
    read -r data_dir config_path < <("$PYTHON" -c "
import sys, os
sys.path.insert(0, os.path.join('$SCRIPT_DIR', 'scripts'))
from config_utils import resolve_data_dir, CONFIG_PATH
print(resolve_data_dir(), CONFIG_PATH)
")

    if [[ "${1:-}" == "--dry" ]]; then
        echo "将清理目录: $data_dir"
        if [[ -d "$data_dir" ]]; then
            echo "目录存在，包含以下内容:"
            ls -la "$data_dir" 2>/dev/null || true
        else
            echo "目录不存在，无需清理。"
        fi
        echo "配置文件: $config_path ($([ -f "$config_path" ] && echo '存在' || echo '不存在'))"
        return 0
    fi

    local messages=()

    if [[ -d "$data_dir" ]]; then
        rm -rf "$data_dir"
        messages+=("已清理数据目录: $data_dir")
    else
        messages+=("数据目录不存在，无需清理: $data_dir")
    fi

    if [[ "${1:-}" != "--data" ]]; then
        if [[ -f "$config_path" ]]; then
            rm -f "$config_path"
            messages+=("已清理配置文件: $config_path")
        else
            messages+=("配置文件不存在，无需清理: $config_path")
        fi
    fi

    printf '{\"success\": true, \"messages\": [%s]}\n' \
        "$(printf '"%s",' "${messages[@]}" | sed 's/,$//')"
}

# --- status 子命令 ---
cmd_status() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        cat <<'EOF'
ar-sign status — 查看当前签约数据状态

检查签约数据文件是否存在、是否过期（> 7 天），展示 meta 信息。

用法:
  ar-sign status     查看状态
  ar-sign status -h  显示此帮助
EOF
        return 0
    fi

    "$PYTHON" -c "
import sys, os, json
sys.path.insert(0, os.path.join('$SCRIPT_DIR', 'scripts'))
from config_utils import get_data_file_path, resolve_data_dir
from datetime import datetime, timezone

data_file = get_data_file_path()
data_dir = resolve_data_dir()
result = {
    'dataDir': data_dir,
    'dataFile': data_file,
    'exists': os.path.exists(data_file),
}

if os.path.exists(data_file):
    try:
        with open(data_file, 'r') as f:
            data = json.load(f)
        meta = data.get('meta', {})
        result['meta'] = meta

        updated = meta.get('updatedAt')
        if updated:
            updated_dt = datetime.fromisoformat(updated.replace('Z', '+00:00'))
            age_days = (datetime.now(timezone.utc) - updated_dt).days
            result['ageDays'] = age_days
            result['expired'] = age_days >= 7
    except Exception as e:
        result['error'] = str(e)

print(json.dumps(result, ensure_ascii=False, indent=2))
"
}

# --- apply 子命令 ---
cmd_apply() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        cat <<'EOF'
ar-sign apply — 外部直调 apply

接收完整 MCP 参数 JSON，校验后直接调用 ar-sign.apply 提交签约申请。
跳过 previewFormView 流程，适用于外围调用方自行组装参数的场景。

用法:
  ar-sign apply --data '<json>'     传入完整 MCP 参数 JSON
  ar-sign apply -h                  显示此帮助

校验规则:
  - request 和 ctx 必须存在
  - request.salesProductCodes 必须为非空列表
  - mccCode（如有）格式必须为 Axxxx_Bxxxx 且不能为默认值

示例:
  ar-sign apply --data '{"request": {"salesProductCodes": ["I1080300001000041203"], "channelCode": "B_SK_SH_RPC", "orderType": "NEW_SIGN"}, "ctx": {}}'
EOF
        return 0
    fi

    "$PYTHON" "$SCRIPT_DIR/scripts/direct_apply.py" "$@"
}

# --- 主入口 ---
if [[ $# -eq 0 || "$1" == "-h" || "$1" == "--help" ]]; then
    show_help
    exit 0
fi

subcmd="$1"
shift

case "$subcmd" in
    config) cmd_config "$@" ;;
    clean)  cmd_clean "$@" ;;
    status) cmd_status "$@" ;;
    apply)  cmd_apply "$@" ;;
    *)
        echo "未知子命令: $subcmd"
        echo "运行 ar-sign -h 查看可用子命令。"
        exit 1
        ;;
esac
